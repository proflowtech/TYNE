.vscode/**
.vscode-test/**
src/**
out/**
.gitignore
tsconfig.json
tsconfig.test.json
esbuild.js
**/*.map
**/*.ts

# Keep production runtime deps that esbuild leaves external
# (typescript, web-tree-sitter). Ignoring all of node_modules
# made marketplace installs fail activation with MODULE_NOT_FOUND.
node_modules/**
!node_modules/typescript/**
!node_modules/web-tree-sitter/**

# Environment files — never ship these
.env
.env.*
.envT

# Test / dev files
test-aicredits.ts
test-aicredits.ts
test-aicredits-openai.ts
test-aicredits.js
test-aicredits.js.map
test-aicredits-openai.js
test-aicredits-openai.js.map

# Supabase backend (not needed in extension)
supabase/**
deno.lock

# Design assets (not shipped)
design_asset/**

# Large unused media files
media/background.svg
media/welcome-bg.png
media/glow.png

# Misc
.claude/**
*.save

# Dev tooling & agent artifacts — never ship
.cursor/**
.agents/**
.vexp/**
scripts/**
react-components/**
skills-lock.json

# Debug logs (may contain sensitive data)
**/*.log
debug-*.log

# Internal docs (keep only README)
PM_INTELLIGENCE_LLM_AUDIT_REPORT.md
**/CHANGELOG.md
