{
  "name": "tyne",
  "displayName": "Tyne",
  "version": "0.1.0",
  "description": "Goal-enforcement layer for AI-assisted coding sessions",
  "license": "MIT",
  "publisher": "tyne",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tyne-sidebar",
          "title": "Tyne",
          "icon": "media/tyne-icon.svg"
        }
      ]
    },
    "views": {
      "tyne-sidebar": [
        {
          "id": "tyneView",
          "name": "Tyne",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tyne.setBYOKKey",
        "title": "Tyne: Set Claude/OpenAI API Key"
      },
      {
        "command": "tyne.connectGitHub",
        "title": "Tyne: Connect GitHub"
      },
      {
        "command": "tyne.reconnectGitHub",
        "title": "Tyne: Reconnect GitHub"
      },
      {
        "command": "tyne.logout",
        "title": "Tyne: Sign Out"
      },
      {
        "command": "tyne.focusSidebar",
        "title": "Tyne: Focus Sidebar"
      },
      {
        "command": "tyne.validateGoal",
        "title": "Tyne: Validate & Review"
      },
      {
        "command": "tyne.runCodeReview",
        "title": "Tyne: Open Validate & Review Reports"
      },
      {
        "command": "tyne.runValidateReview",
        "title": "Tyne: Validate & Review Last Edit"
      },
      {
        "command": "tyne.clearReviewDiagnostics",
        "title": "Tyne: Clear Review Diagnostics"
      },
      {
        "command": "tyne.connectJira",
        "title": "Tyne: Connect Jira"
      },
      {
        "command": "tyne.disconnectJira",
        "title": "Tyne: Disconnect Jira"
      },
      {
        "command": "tyne.refreshJiraTasks",
        "title": "Tyne: Refresh Jira Tasks"
      },
      {
        "command": "tyne.changeJiraProject",
        "title": "Tyne: Change Jira Project"
      },
      {
        "command": "tyne.connectLinear",
        "title": "Tyne: Connect Linear"
      },
      {
        "command": "tyne.disconnectLinear",
        "title": "Tyne: Disconnect Linear"
      },
      {
        "command": "tyne.refreshLinearTasks",
        "title": "Tyne: Refresh Linear Tasks"
      },
      {
        "command": "tyne.changeLinearTeam",
        "title": "Tyne: Change Linear Team"
      }
    ],
    "keybindings": [
      {
        "command": "tyne.validateGoal",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "focusedView == tyneView || activeViewlet == workbench.view.extension.tyne-sidebar"
      }
    ],
    "configuration": {
      "title": "Tyne",
      "properties": {
        "tyne.byokProvider": {
          "type": "string",
          "enum": [
            "claude",
            "openai"
          ],
          "default": "claude",
          "description": "AI provider for BYOK validation"
        },
        "tyne.githubClientId": {
          "type": "string",
          "default": "Iv23liwppROR1owPnJek",
          "description": "The GitHub OAuth Client ID for device flow authentication."
        },
        "tyne.supabaseUrl": {
          "type": "string",
          "default": "https://mvzcfqjtleasuawvvmtg.supabase.co",
          "description": "Tyne Supabase project URL used for hosted Edge Functions (US / default)."
        },
        "tyne.supabaseUrlEu": {
          "type": "string",
          "default": "",
          "description": "Optional EU-region Supabase project URL when Data Processing Location is EU."
        },
        "tyne.enterpriseValidateReviewUrl": {
          "type": "string",
          "default": "",
          "description": "Self-hosted or enterprise-managed Validate & Review endpoint (project URL or …/functions/v1/tyne-validate-review)."
        },
        "tyne.managedValidationModel": {
          "type": "string",
          "default": "",
          "description": "Optional AICredits model ID override sent to the Tyne managed validation backend. Leave empty to use Tyne's managed fallback policy."
        },
        "tyne.jira.assignedToMe": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, Jira pulls only issues assigned to the authenticated Atlassian user."
        },
        "tyne.linear.assignedToMe": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, Linear pulls only issues assigned to the authenticated Linear user."
        },
        "tyne.asana.apiKey": {
          "type": "string",
          "default": "",
          "description": "Asana personal access token used to update tasks and post comments."
        },
        "tyne.notion.apiKey": {
          "type": "string",
          "default": "",
          "description": "Notion integration token used to update database row status."
        },
        "tyne.notion.databaseId": {
          "type": "string",
          "default": "",
          "description": "Notion database ID that contains Tyne-tracked tasks."
        },
        "tyne.notion.statusProperty": {
          "type": "string",
          "default": "Status",
          "description": "Notion database status property name."
        },
        "tyne.projectLeadMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable Project Lead Mode: auto workspace prep, drift detection, AI commit synthesis, and auto ticket close."
        },
        "tyne.defaultBranch": {
          "type": "string",
          "default": "main",
          "description": "Default branch to pull from before starting a thread."
        },
        "tyne.driftSensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "How aggressively Tyne flags off-scope file edits."
        },
        "tyne.validateReviewLineThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Net new lines added across the workspace before Tyne suggests running Validate & Review."
        },
        "tyne.validationReminders.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show automatic Validate & Review reminders for large edits, syntax errors, and long coding sessions."
        },
        "tyne.validationReminders.cooldownMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "description": "Minimum minutes between Validate & Review reminder notifications."
        },
        "tyne.validationReminders.sessionMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "description": "Minutes of active coding before Tyne suggests a Validate & Review checkpoint."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "node esbuild.js --production",
    "compile": "tsc -p ./",
    "esbuild": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run compile && node --test out/tests/**/*.test.js",
    "debug:aicredits-models": "node scripts/list-aicredits-models.mjs",
    "test:api": "ts-node --project tsconfig.test.json test-aicredits.ts",
    "test:api:openai": "ts-node --project tsconfig.test.json test-aicredits-openai.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@types/dotenv": "^6.1.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "openai": "^6.45.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "simple-git": "^3.22.0"
  }
}
