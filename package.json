{
  "name": "tyne",
  "displayName": "Tyne",
  "version": "0.1.0",
  "description": "Goal-enforcement layer for AI-assisted coding sessions",
  "license": "MIT",
  "publisher": "tyne",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tyne-sidebar",
          "title": "Tyne",
          "icon": "media/tyne-icon.svg"
        }
      ]
    },
    "views": {
      "tyne-sidebar": [
        {
          "id": "tyneView",
          "name": "Tyne",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tyne.setBYOKKey",
        "title": "Tyne: Set Claude/OpenAI API Key"
      },
      {
        "command": "tyne.connectGitHub",
        "title": "Tyne: Connect GitHub"
      },
      {
        "command": "tyne.logout",
        "title": "Tyne: Logout"
      },
      {
        "command": "tyne.focusSidebar",
        "title": "Tyne: Focus Sidebar"
      }
    ],
    "configuration": {
      "title": "Tyne",
      "properties": {
        "tyne.byokProvider": {
          "type": "string",
          "enum": [
            "claude",
            "openai"
          ],
          "default": "claude",
          "description": "AI provider for BYOK validation"
        },
        "tyne.githubClientId": {
          "type": "string",
          "default": "Iv23liwppROR1owPnJek",
          "description": "The GitHub OAuth Client ID for device flow authentication."
        },
        "tyne.projectLeadMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable Project Lead Mode: auto workspace prep, drift detection, AI commit synthesis, and auto ticket close."
        },
        "tyne.defaultBranch": {
          "type": "string",
          "default": "main",
          "description": "Default branch to pull from before starting a thread."
        },
        "tyne.driftSensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "How aggressively Tyne flags off-scope file edits."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/tests/**/*.test.js"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "simple-git": "^3.22.0"
  }
}
